{
  "name": "the-core-show-planner-aero",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hour-long radio show planner for 90.3 The Core (WVPH), Rutgers University",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "SINGLE_FILE=1 vite build --outDir dist-single",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "apple-token": "node scripts/apple-token.mjs",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/bowlby-one": "*",
    "@fontsource/dm-sans": "*",
    "@fontsource/permanent-marker": "*",
    "@fontsource/rubik-spray-paint": "*",
    "@fontsource/space-mono": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "vitest": "^5.0.4",
    "vite-plugin-singlefile": "^2.3.3",
    "@types/node": "^26.6.5",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.13.0",
    "@sparticuz/chromium": "^153.0.0"
  }
}